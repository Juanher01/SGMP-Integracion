        <mxCell id="layer-detalle" parent="Zfa-h7b1mF_UkIyc46Zn-0" value="Detalle de comunicación" visible="0" />
        <mxCell id="det-bd" parent="layer-detalle" style="rounded=1;fillColor=#FDEDEC;strokeColor=#B85450;strokeWidth=1.5;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=1;" value="PostgreSQL — CN-001&#xa;Interno: 5432 · Origen: backend sin puerto fijo (cliente)&#xa;DEV 5447 / TEST 5448: publicados al host → hallazgo activo&#xa;PROD: docker-compose.prod.yml NO publica la base (solo red interna).&#xa;El 5449 queda solo como reserva documental; acceso por túnel SSH.&#xa;TLS: sin sslmode en ningún ambiente." vertex="1">
          <mxGeometry height="120" width="440" x="860" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="det-broker" parent="layer-detalle" style="rounded=1;fillColor=#FFF6ED;strokeColor=#D79B00;strokeWidth=1.5;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=1;" value="Broker MQTT — CN-002 / CN-003&#xa;Interno: TCP 1883 · WS 9001 · Gateway HTTP 8000&#xa;Autenticación: SÍ — credenciales separadas para gateway y dispositivos&#xa;ACL por tópico: SÍ en DEV/TEST (dynamic-security, SEG-BROKER-03);&#xa;   NO en PROD (main sin promover) → CN-002 sigue abierto para PROD&#xa;TLS: soportado en DEV/TEST (MQTT 8883 · WSS 9002, SEG-BROKER-02) pero&#xa;   sin activar en ningún ambiente; PROD pendiente de promoción → CN-003&#xa;Listener WebSocket (9001, texto plano) sin consumidor conocido (el frontend usa polling)&#xa;Gateway persiste telemetría en la BD compartida (modulo3 / modulo9):&#xa;diseño: red interna; hoy DATABASE_URL usa host:puerto publicado y rol dba." vertex="1">
          <mxGeometry height="200" width="560" x="-140" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="det-lb" parent="layer-detalle" style="rounded=1;fillColor=#F7F7F7;strokeColor=#999999;strokeWidth=1.5;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=1;" value="Load Balancer — objetivo de arquitectura PROD&#xa;Sería Traefik (Dokploy): mismo proxy que ya termina TLS, con&#xa;balanceo round-robin nativo entre réplicas.&#xa;OJO: docker-compose.prod.yml corre el backend MONOPROCESO a propósito&#xa;(rate limiter y semáforo del broker viven en memoria del proceso).&#xa;Escalar a 2 instancias exige migrarlos a estado compartido antes." vertex="1">
          <mxGeometry height="130" width="400" x="1400" y="-330" as="geometry" />
        </mxCell>
        <mxCell id="det-subs" parent="layer-detalle" style="rounded=1;fillColor=#FFF6ED;strokeColor=#D79B00;strokeWidth=1.5;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=1;" value="Nota abierta: con 2 instancias suscritas al mismo broker,&#xa;falta definir si ambas procesan cada mensaje o si se necesita&#xa;un grupo de suscripción compartido para evitar duplicados." vertex="1">
          <mxGeometry height="90" width="420" x="1340" y="1050" as="geometry" />
        </mxCell>
