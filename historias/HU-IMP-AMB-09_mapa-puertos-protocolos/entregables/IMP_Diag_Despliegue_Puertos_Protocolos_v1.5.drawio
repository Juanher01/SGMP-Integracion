        <mxCell id="leyenda-1" parent="Zfa-h7b1mF_UkIyc46Zn-1" style="text;html=1;align=left;fontSize=9;fontStyle=2;strokeColor=none;fillColor=none;fontColor=#666666;" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(102, 102, 102), rgb(149, 149, 149));&quot;&gt;Capas (Ctrl+Shift+L): «Capa Base» = cajas fijas (siempre visible) ·&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(102, 102, 102), rgb(149, 149, 149));&quot;&gt;«Capa DEV» / «Capa TEST / Sandbox» / «Capa PROD» = URLs y puertos de host de cada ambiente (enciende UNA a la vez)&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(102, 102, 102), rgb(149, 149, 149));&quot;&gt;«Capa Protocolos» = flechas con su protocolo y puerto INTERNO (no cambia entre ambientes) ·&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(102, 102, 102), rgb(149, 149, 149));&quot;&gt;«Hallazgos» y «Detalle de comunicación» = apoyo, apagadas por defecto.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="760" x="-140" y="740" as="geometry" />
        </mxCell>
