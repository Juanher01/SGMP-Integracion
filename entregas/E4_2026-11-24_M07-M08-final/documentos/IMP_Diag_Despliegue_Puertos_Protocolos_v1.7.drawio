        <mxCell id="leyenda-1" parent="Zfa-h7b1mF_UkIyc46Zn-1" style="text;html=1;align=left;fontSize=9;fontStyle=2;strokeColor=none;fillColor=none;fontColor=#666666;" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(102, 102, 102), rgb(149, 149, 149));&quot;&gt;Capas (Ctrl+Shift+L): «Capa Base» = cajas fijas (siempre visible) ·&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(102, 102, 102), rgb(149, 149, 149));&quot;&gt;«Capa DEV» / «Capa TEST / Sandbox» / «Capa PROD» = URLs y puertos de host de cada ambiente (enciende UNA a la vez)&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(102, 102, 102), rgb(149, 149, 149));&quot;&gt;«Capa Protocolos» = flechas con su protocolo y puerto INTERNO (no cambia entre ambientes) ·&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(102, 102, 102), rgb(149, 149, 149));&quot;&gt;«Hallazgos» = apoyo, apagada por defecto · «Detalle de comunicación» = notas de apoyo, encendida.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(102, 102, 102), rgb(149, 149, 149));&quot;&gt;«Objetivo (no desplegado)» = cajas y flechas punteadas de la arquitectura objetivo, apagada por defecto.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="560" x="-150" y="780" as="geometry" />
        </mxCell>
        <mxCell id="ctl-version" parent="Zfa-h7b1mF_UkIyc46Zn-1" style="rounded=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;html=1;" value="&lt;b&gt;IMP_Diag_Despliegue_Puertos_Protocolos · v1.7&lt;/b&gt;&lt;br&gt;Fecha: 2026-11-23 · Autores: Sebastián Sandoval Chavarro y Juan Hernando Perdomo Mosquera&lt;br&gt;Cambios: dos servidores (backend y broker), tramos MQTT, dominios verificados con curl y puertos de CA-4&lt;br&gt;(HU-IMP-DOC-03). Base: v1.6 (HU-IMP-DOC-02)&lt;br&gt;Dato de Despliegue: un servidor del broker para los 3 entornos, puertos de Dokploy,&amp;nbsp;&lt;div&gt;PROD con docker-compose.yml&lt;/div&gt;" vertex="1">
