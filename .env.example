# =========================================================
# .env.example — SGPMP, plantilla de variables de entorno
#
# Copia este archivo como .env.dev / .env.test / .env.prod y rellena valores
# reales. Los tres NO deben subirse al repo (ya están en .gitignore).
# Esta plantilla documenta QUÉ variables existen; los valores reales viven
# solo en tu copia local o en el gestor de secretos del entorno correspondiente.
# =========================================================

# ---- Backend: JWT / CORS ----
SECRET_KEY=
FRONTEND_URL=

# ---- Backend: servicios externos (pendiente de Desarrollo, ver Reporte-inquietudes-equipos.md) ----
# EXTERNAL_USERS_API_URL=
# AUDIT_SERVICE_URL=
# (Firebase/OAuth del backend, si aplica — completar cuando Desarrollo confirme cuáles usa)

# ---- Base de datos: piezas sueltas (el compose arma DATABASE_URL a partir de estas) ----
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_APP_USER=
DB_APP_PASSWORD=

# ---- Contraseñas de arranque del contenedor de BD (las usa 00-init-roles.sh del DBA) ----
DBA_PASSWORD=
BACKEND_DEV_PASSWORD=
QA_PASSWORD=
DEVOPS_DEV_PASSWORD=
DEVOPS_STAGING_PASSWORD=
DEVOPS_PROD_PASSWORD=
IOT_PASSWORD=

# ---- Frontend: se HORNEAN en el build (docker-compose las pasa como build args, no runtime) ----
VITE_API_BASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_VAPID_KEY=
