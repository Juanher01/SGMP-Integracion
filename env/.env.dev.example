# =========================================================
# SGPMP - DEV
# =========================================================

ENVIRONMENT=dev

# =========================================================
# Imágenes de servicios
# En DEV backend/frontend/database/gateway se construyen localmente.
# Se conservan estas variables para mantener el mismo contrato entre ambientes.
# =========================================================

DATABASE_IMAGE=
BACKEND_IMAGE=
FRONTEND_IMAGE=
GATEWAY_IMAGE=

# =========================================================
# PostgreSQL
# =========================================================

DB_HOST=host.docker.internal
DB_PORT=5433
DB_NAME=dba

DB_ADMIN_USER=dba

DB_APP_USER=dba
DB_APP_PASSWORD=

DB_IOT_USER=
DB_IOT_PASSWORD=

DB_SCHEMA_INGEST=modulo3
DB_SCHEMA_REGISTRY=modulo9

# =========================================================
# Backend - Aplicación / Seguridad
# =========================================================

FRONTEND_URL=http://localhost:5173

SECRET_KEY=
JWT_EXPIRE_HOURS=24
RF71_INTERNAL_KEY=

# Firebase Backend
# Ruta al archivo de credenciales dentro del contenedor.
FIREBASE_CREDENTIALS_PATH=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Almacenamiento local de modelos
MODELOS_STORAGE_PATH=/tmp/sgpmp_modelos

# =========================================================
# Frontend
# =========================================================

VITE_API_BASE_URL=http://localhost:8000
VITE_SW=false
VITE_AGROFUSION_LOGIN_URL=

# Firebase Frontend
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_VAPID_KEY=

# =========================================================
# Gateway AIoT / Seguridad
# =========================================================

GATEWAY_API_TOKEN=

# =========================================================
# Broker MQTT
# =========================================================

MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CLIENT_ID=sgpmp
MQTT_RECONNECT_DELAY=5

# Topics MQTT
MQTT_TOPIC_PREFIX=sgpmp
MQTT_TOPIC_TELEMETRY=telemetry
MQTT_TOPIC_HEARTBEAT=heartbeat
MQTT_TOPIC_COMMAND=command
MQTT_TOPIC_STATUS=status
