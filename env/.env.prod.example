# =========================================================
# SGPMP - PROD
# =========================================================

ENVIRONMENT=prod

# =========================================================
# Imágenes de servicios
# PROD consume imágenes versionadas.
# =========================================================

DATABASE_IMAGE=
BACKEND_IMAGE=
FRONTEND_IMAGE=
GATEWAY_IMAGE=

# =========================================================
# PostgreSQL
# =========================================================

DB_HOST=database
DB_PORT=5432
DB_NAME=dba

DB_ADMIN_USER=dba

DB_APP_USER=
DB_APP_PASSWORD=

DB_IOT_USER=
DB_IOT_PASSWORD=

DB_SCHEMA_INGEST=modulo3
DB_SCHEMA_REGISTRY=modulo9

# =========================================================
# Backend - Aplicación / Seguridad
# =========================================================

FRONTEND_URL=

SECRET_KEY=
JWT_EXPIRE_HOURS=24
RF71_INTERNAL_KEY=

# Firebase Backend
FIREBASE_CREDENTIALS_PATH=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Almacenamiento de modelos
MODELOS_STORAGE_PATH=/tmp/sgpmp_modelos

# =========================================================
# Frontend
# =========================================================

VITE_API_BASE_URL=
VITE_SW=true
VITE_AGROFUSION_LOGIN_URL=

# Firebase Frontend
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_VAPID_KEY=

# =========================================================
# Gateway AIoT / Seguridad
# =========================================================

GATEWAY_API_TOKEN=

# =========================================================
# Broker MQTT
# =========================================================

MQTT_HOST=
MQTT_PORT=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=true
MQTT_CLIENT_ID=sgpmp
MQTT_RECONNECT_DELAY=5

# Topics MQTT
MQTT_TOPIC_PREFIX=sgpmp
MQTT_TOPIC_TELEMETRY=telemetry
MQTT_TOPIC_HEARTBEAT=heartbeat
MQTT_TOPIC_COMMAND=command
MQTT_TOPIC_STATUS=status